# ─── Deployment Mode ─────────────────────────────────────────────────────────
# SIMULATED  = all data generated synthetically  (demo / offline)
# LIVE       = real API calls where available, fallback to SIMULATED
MODE=SIMULATED

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=oresense_dev

# ─── Area of Interest (Balaghat manganese belt, MP) ──────────────────────────
AOI_MINLAT=21.60
AOI_MAXLAT=21.73
AOI_MINLON=80.58
AOI_MAXLON=80.71
GRID_ROWS=20
GRID_COLS=13

# ─── Satellite APIs (leave blank to fall back to SIMULATED) ──────────────────
COPERNICUS_USER=
COPERNICUS_PASSWORD=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
NASA_EARTHDATA_USER=
NASA_EARTHDATA_PASSWORD=

# ─── Weather (Open-Meteo is free/no-key; NASA POWER also free) ───────────────
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ─── Model settings ──────────────────────────────────────────────────────────
MODEL_RETRAIN_INTERVAL_HOURS=6
FL_ROUNDS=5
FL_MIN_CLIENTS=3
RL_TIMESTEPS=50000

# ─── MQTT ────────────────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883

# ─── Secrets ─────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production_please
